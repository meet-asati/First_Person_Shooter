# =========================================================================
# Standard Unity .gitignore Template
# Place at the root of your Unity project directory.
# =========================================================================

# Unity auto-generated and local cache folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Memory captures and recordings can become excessively large
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset store tokens/plugin data
/[Aa]ssets/AssetStoreTools*

# Autogenerated Android/Gradle builds
.gradle/
.utmp/

# WebGL build logs
*.log

# Blender backup files (Unity natively converts .blend files)
*.blend1
*.blend1.meta

# =========================================================================
# IDE and Solution Files
# =========================================================================
# Visual Studio
.vs/
.vsconfig
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files for IDEs
*.pidb.meta
*.pdb.meta
*.mdb.meta

# JetBrains Rider
.idea/
[Aa]ssets/Plugins/Editor/JetBrains*

# VS Code
.vscode/

# =========================================================================
# OS specific files
# =========================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
